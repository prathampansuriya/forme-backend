# ==========================================
# FORME BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Environment
NODE_ENV=development # development | production | test
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"

# JWT Authentication
JWT_ACCESS_SECRET="forme_access_token_super_secret_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="forme_refresh_token_super_secret_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth 2.0 (Identity Services)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Razorpay Payments Gateway
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Cloudinary Luxury Media Storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Transactional Email Engine
EMAIL_PROVIDER=nodemailer # nodemailer (development) | brevo (production)
EMAIL_FROM_NAME="FORME"
EMAIL_FROM_ADDRESS="concierge@forme.store"

# Nodemailer Local SMTP (Development / Staging)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"

# Brevo Transactional API (Production Delivery)
BREVO_API_KEY="xkeysib-your_brevo_api_key"
BREVO_SENDER_NAME="FORME"
BREVO_SENDER_EMAIL="concierge@forme.store"
